# =============================================================================
# GV Nutrition — BACKEND reference config.
# Copy to backend/.env and fill in. Never commit the real .env.
# =============================================================================

# PostgreSQL — Supabase (GV Nutrition has its OWN project, separate from Attire)
# DATABASE_URL : transaction-mode pooler, port 6543, app runtime. Keep ?pgbouncer=true
# DIRECT_URL   : session-mode pooler,     port 5432, used by Prisma for migrations
# URL-encode special characters in the password (e.g. @ becomes %40)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Server
# GV Nutrition uses 4100/5273 so it can run alongside Attire (4000/5173) locally.
NODE_ENV=development
PORT=4100

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5273

LOG_LEVEL=info

# JWT — generate fresh strong values per environment (32+ chars).
# Never reuse Attire's secrets. Production values go in Railway, not here.
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars-dev
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars-dev
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# bcrypt cost (10–14)
BCRYPT_COST=12

# First admin only: set true once against an empty DB, create the user, then disable.
AUTH_BOOTSTRAP_ENABLED=false

# Store profile — printed on the invoice PDF. Not stored in the DB.
STORE_NAME=GV Nutrition
STORE_ADDRESS=Surat, Gujarat
STORE_PHONE=
STORE_EMAIL=gvnutritionsurat@gmail.com
STORE_GSTIN=
# Backend-relative path to the invoice logo PNG.
STORE_LOGO_PATH=assets/logo.png
STORE_INVOICE_THANK_YOU=Thank you for shopping with us. We look forward to seeing you again.
STORE_RETURN_POLICY=Returns & exchanges within 7 days with original bill intact.

# ─── WhatsApp invoice delivery (WATI) ───────────────────────────────────────
# Shared WATI account with Attire; only the TEMPLATE and the store name differ.
#
# Leave WHATSAPP_ENABLED=false to run in DRY-RUN: the app records the intent in
# whatsapp_logs and never calls WATI. Nothing else breaks. Flip to true only once
# all four values below are filled — the app refuses to boot otherwise, on purpose,
# so a half-configured deploy fails loudly instead of silently not sending.
#
# The approved template MUST take exactly four variables, in this order:
#   {{1}} customer name   {{2}} invoice number
#   {{3}} amount          {{4}} invoice PDF link
WHATSAPP_ENABLED=false

# From WATI → API Docs. Tenant-specific, e.g. https://live-mt-server.wati.io/1234567
WATI_BASE_URL=
# WATI → API Docs → Access Token. Pasting it with or without the "Bearer " prefix both work.
WATI_ACCESS_TOKEN=
# Exact name of the APPROVED nutrition template in WATI (not Attire's).
WATI_INVOICE_TEMPLATE_NAME=
# Campaign label shown in WATI reporting. Blank falls back to the template name.
WATI_BROADCAST_NAME=

# Base URL of THIS BACKEND — it builds the customer's invoice link as
# <PUBLIC_API_BASE_URL>/i/<orderId>. Must be the API host and publicly reachable:
# the customer opens it from WhatsApp with no login. NOT the frontend URL.
# e.g. https://gvnutrition-backend-production.up.railway.app
PUBLIC_API_BASE_URL=
