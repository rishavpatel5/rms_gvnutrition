// GV Nutrition RMS — supplements & nutrition retail schema.
// Adapted from the Attire by GV engine: all money math, the inventory ledger and
// the GST engine are UNCHANGED. Only the product model and branding differ.
// PostgreSQL / Supabase compatible. Use migrations only (no db-specific hacks).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Staff & access (JWT + refresh tokens; RBAC in middleware)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CASHIER
  INVENTORY_MANAGER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens            RefreshToken[]
  inventoryLogsCreated   InventoryLog[] @relation("InventoryLogCreatedBy")
  ordersCreated          Order[]        @relation("OrderCreatedBy")
  purchaseOrdersCreated  PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  stockAdjustmentsCreated StockAdjustment[] @relation("StockAdjustmentCreatedBy")
  notifications          Notification[]
  bulkImportBatchesCreated    BulkImportBatch[] @relation("BulkImportBatchCreatedBy")
  bulkImportBatchesRolledBack BulkImportBatch[] @relation("BulkImportBatchRolledBackBy")
  purchaseReturnsCreated      PurchaseReturn[]  @relation("PurchaseReturnCreatedBy")
  purchaseReturnsConfirmed    PurchaseReturn[]  @relation("PurchaseReturnConfirmedBy")

  @@map("users")
}

/// Opaque refresh tokens are stored hashed (SHA-256). Plain token is only returned at login/refresh.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalog: brands, flavours, pack sizes, products, variants, media
// ---------------------------------------------------------------------------

/// Manufacturer (Optimum Nutrition, MuscleBlaze, …). A managed entity rather than
/// free text so brand-wise filtering and reporting cannot fragment into
/// "ON" / "Optimum" / "optimum nutrition". Owner-editable.
///
/// NOTE: product categories were REMOVED from this system at the owner's request.
/// Brand is the grouping that matters here; do not reintroduce a Category model.
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("brands")
}

/// First of the two optional per-SKU attributes (was Colour in the apparel system).
/// Seeded with only Chocolate + Unflavoured; the owner adds the rest via the UI.
model Flavour {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("flavours")
}

/// How a pack is measured. Nutrition packs are not ordinal like clothing sizes —
/// they are magnitudes in three incompatible units.
enum PackSizeMeasure {
  WEIGHT // grams / kilograms — whey, gainer, creatine, oats
  VOLUME // millilitres / litres — liquid supplements
  COUNT  // pieces — tablets, capsules
  SACHET // single-serve packets in a box — e.g. "30 sachets"
}

/// Second of the two optional per-SKU attributes (was Size). A SHARED table:
/// "1kg" is ONE row reused by every product that needs it, not free text per product.
model PackSize {
  id        String          @id @default(cuid())
  /// Display label exactly as staff say it at the counter: "1kg", "500ml", "60 tablets".
  label     String
  code      String          @unique
  measure   PackSizeMeasure
  /// Normalized magnitude used for sorting WITHIN a measure: grams for WEIGHT,
  /// millilitres for VOLUME, pieces for COUNT. Without this, "500g" sorts before
  /// "1kg" alphabetically and every listing looks broken. Never compare across measures.
  normalizedValue Decimal   @map("normalized_value") @db.Decimal(12, 3)
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@unique([measure, label])
  @@index([measure, normalizedValue])
  @@map("pack_sizes")
}

enum ProductKind {
  SUPPLEMENT
  ACCESSORY
}

enum GstPricingMode {
  INCLUSIVE
  EXCLUSIVE
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  kind        ProductKind
  /// Optional HSN code. Entered once per product; printed on the invoice only
  /// when filled, so a blank costs nothing.
  hsnCode     String?     @map("hsn_code")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  variants ProductVariant[]
  offerProducts OfferProduct[]

  @@index([kind, isActive])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  sku        String   @unique
  listPrice  Decimal  @default(0) @map("list_price") @db.Decimal(12, 2)
  costPrice  Decimal? @map("cost_price") @db.Decimal(12, 2)
  gstEnabled Boolean  @default(true) @map("gst_enabled")
  gstPricingMode GstPricingMode @default(INCLUSIVE) @map("gst_pricing_mode")
  cgstRate   Decimal  @default(0) @map("cgst_rate") @db.Decimal(6, 3)
  sgstRate   Decimal  @default(0) @map("sgst_rate") @db.Decimal(6, 3)
  igstRate   Decimal  @default(0) @map("igst_rate") @db.Decimal(6, 3)
  lowStockThreshold Int? @map("low_stock_threshold")
  /// Manufacturer of THIS item. Brand sits here, not on the product, so that
  /// "Whey Protein · Chocolate · 500g" from two companies are two distinct
  /// variants of one product, each with its own cost, price and stock.
  brandId    String?  @map("brand_id")
  /// Both attributes stay OPTIONAL — unflavoured creatine or a plain shaker
  /// may leave either blank, exactly as Attire allowed blank colour/size.
  flavourId  String?  @map("flavour_id")
  packSizeId String?  @map("pack_size_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  flavour   Flavour?  @relation(fields: [flavourId], references: [id], onDelete: Restrict)
  packSize  PackSize? @relation(fields: [packSizeId], references: [id], onDelete: Restrict)
  inventory InventoryBalance?
  logs      InventoryLog[]
  orderItems           OrderItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReturnLines  PurchaseReturnLine[]
  stockAdjustmentLines StockAdjustmentLine[]

  @@index([productId])
  @@index([flavourId])
  @@index([packSizeId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Inventory: authoritative balance row + append-only logs (mandatory)
// ---------------------------------------------------------------------------

model InventoryBalance {
  variantId String   @id @map("variant_id")
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory_balances")
}

enum InventoryMovementType {
  SALE_OUT
  SALE_REVERSAL_IN
  PURCHASE_IN
  PURCHASE_RETURN_OUT
  RETURN_RESTOCK_IN
  EXCHANGE_OUT
  EXCHANGE_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE_OUT
}

enum InventoryReferenceKind {
  ORDER
  PURCHASE_ORDER
  PURCHASE_RETURN
  SALES_RETURN
  EXCHANGE
  STOCK_ADJUSTMENT
}

model InventoryLog {
  id              String                   @id @default(cuid())
  variantId       String                   @map("variant_id")
  quantityDelta   Int                      @map("quantity_delta")
  movementType    InventoryMovementType    @map("movement_type")
  referenceKind   InventoryReferenceKind   @map("reference_kind")
  referenceId     String                   @map("reference_id")
  note            String?
  metadata        Json?
  createdById     String?                  @map("created_by_id")
  createdAt       DateTime                 @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("InventoryLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt(sort: Desc)])
  @@index([referenceKind, referenceId])
  @@index([createdAt(sort: Desc)])
  @@map("inventory_logs")
}

enum StockAdjustmentReason {
  DAMAGE
  /// Manual expiry write-off. NO expiry dates are captured at purchase time —
  /// staff spot an expired product on the shelf and write it off here. Kept
  /// SEPARATE from DAMAGE so expiry loss is reportable on its own.
  EXPIRED
  SHRINKAGE
  FOUND
  CORRECTION
  OTHER
}

model StockAdjustment {
  id          String                 @id @default(cuid())
  reason      StockAdjustmentReason
  note        String?
  createdById String?                @map("created_by_id")
  createdAt   DateTime               @default(now()) @map("created_at")

  createdBy User? @relation("StockAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines       StockAdjustmentLine[]

  @@index([createdAt(sort: Desc)])
  @@map("stock_adjustments")
}

/// One stock adjustment document can move multiple variants; each line maps to one inventory log row.
model StockAdjustmentLine {
  id                String                @id @default(cuid())
  stockAdjustmentId String              @map("stock_adjustment_id")
  variantId         String              @map("variant_id")
  quantityDelta     Int                 @map("quantity_delta")
  movementType      InventoryMovementType @map("movement_type")
  createdAt         DateTime            @default(now()) @map("created_at")

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([stockAdjustmentId])
  @@index([variantId])
  @@map("stock_adjustment_lines")
}

// ---------------------------------------------------------------------------
// CRM: customers
// ---------------------------------------------------------------------------

model Customer {
  id                 String    @id @default(cuid())
  phone              String?   @unique
  email              String?   @unique
  fullName           String    @map("full_name")
  notes              String?
  marketingOptIn      Boolean   @default(false) @map("marketing_opt_in")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  orders       Order[]
  whatsappLogs WhatsAppLog[]

  @@index([fullName])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Suppliers & purchasing
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   Json?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@index([name])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String                @id @default(cuid())
  supplierId   String                @map("supplier_id")
  status       PurchaseOrderStatus   @default(DRAFT)
  subtotal           Decimal           @default(0) @map("subtotal") @db.Decimal(14, 2)
  discountTotal      Decimal           @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxableValueTotal  Decimal           @default(0) @map("taxable_value_total") @db.Decimal(14, 2)
  cgstTotal          Decimal           @default(0) @map("cgst_total") @db.Decimal(14, 2)
  sgstTotal          Decimal           @default(0) @map("sgst_total") @db.Decimal(14, 2)
  igstTotal          Decimal           @default(0) @map("igst_total") @db.Decimal(14, 2)
  grandTotal         Decimal           @default(0) @map("grand_total") @db.Decimal(14, 2)
  amountPaid         Decimal           @default(0) @map("amount_paid") @db.Decimal(14, 2)
  orderedAt    DateTime?             @map("ordered_at")
  receivedAt   DateTime?             @map("received_at")
  createdById  String?               @map("created_by_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  bulkImportBatchId String?          @map("bulk_import_batch_id")

  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bulkImportBatch BulkImportBatch? @relation(fields: [bulkImportBatchId], references: [id], onDelete: SetNull)
  items           PurchaseOrderItem[]

  @@index([supplierId, status])
  @@index([createdAt(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String   @id @default(cuid())
  purchaseOrderId   String   @map("purchase_order_id")
  variantId         String   @map("variant_id")
  quantityOrdered   Int      @map("quantity_ordered")
  quantityReceived  Int      @default(0) @map("quantity_received")
  /// Unit cost as entered in the purchase grid (GST inclusive or exclusive per `gstPricingMode`).
  unitCost          Decimal  @map("unit_cost") @db.Decimal(14, 4)
  gstEnabled        Boolean  @default(true) @map("gst_enabled")
  gstPricingMode    GstPricingMode @default(EXCLUSIVE) @map("gst_pricing_mode")
  cgstRate          Decimal  @default(0) @map("cgst_rate") @db.Decimal(6, 3)
  sgstRate          Decimal  @default(0) @map("sgst_rate") @db.Decimal(6, 3)
  igstRate          Decimal  @default(0) @map("igst_rate") @db.Decimal(6, 3)
  taxableValue      Decimal  @default(0) @map("taxable_value") @db.Decimal(14, 4)
  cgstAmount        Decimal  @default(0) @map("cgst_amount") @db.Decimal(14, 4)
  sgstAmount        Decimal  @default(0) @map("sgst_amount") @db.Decimal(14, 4)
  igstAmount        Decimal  @default(0) @map("igst_amount") @db.Decimal(14, 4)
  lineTotal         Decimal  @default(0) @map("line_total") @db.Decimal(14, 4)
  /// Per-unit pre-tax cost (for WAC / COGS); equals line taxable / qty.
  unitCostExclusive Decimal  @map("unit_cost_exclusive") @db.Decimal(14, 6)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([variantId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Commercial: orders, lines, payments, offers
// ---------------------------------------------------------------------------

/// Single-row counter used inside billing transactions to allocate unique invoice numbers.
model InvoiceSequence {
  id        String   @id @default("singleton")
  nextSeq   Int      @default(0) @map("next_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoice_sequence")
}

enum OrderDocumentType {
  SALE
  CREDIT_NOTE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  VOIDED
}

/// Item- and cart-level POS discounts (aligned with offer engine semantics).
enum RetailDiscountType {
  PERCENT
  FLAT_AMOUNT
}

model Order {
  id                 String            @id @default(cuid())
  documentType       OrderDocumentType @default(SALE) @map("document_type")
  status             OrderStatus       @default(DRAFT)
  invoiceNumber      String?           @unique @map("invoice_number")
  customerId         String?           @map("customer_id")
  /// True when a POS sale has no linked CRM customer (anonymous checkout).
  isWalkIn           Boolean           @default(false) @map("is_walk_in")
  originalSaleId   String?           @map("original_sale_id")
  gstEnabled         Boolean           @default(false) @map("gst_enabled")
  gstPricingMode     GstPricingMode    @default(INCLUSIVE) @map("gst_pricing_mode")
  currency           String            @default("INR")
  subtotal           Decimal           @db.Decimal(14, 2)
  discountTotal      Decimal           @default(0) @map("discount_total") @db.Decimal(14, 2)
  itemDiscountTotal  Decimal           @default(0) @map("item_discount_total") @db.Decimal(14, 2)
  cartDiscountType   RetailDiscountType? @map("cart_discount_type")
  cartDiscountValue  Decimal?          @map("cart_discount_value") @db.Decimal(14, 4)
  cartDiscountAmount Decimal           @default(0) @map("cart_discount_amount") @db.Decimal(14, 2)
  taxableValue       Decimal           @default(0) @map("taxable_value") @db.Decimal(14, 2)
  cgstTotal          Decimal           @default(0) @map("cgst_total") @db.Decimal(14, 2)
  sgstTotal          Decimal           @default(0) @map("sgst_total") @db.Decimal(14, 2)
  igstTotal          Decimal           @default(0) @map("igst_total") @db.Decimal(14, 2)
  cessTotal          Decimal           @default(0) @map("cess_total") @db.Decimal(14, 2)
  grandTotal         Decimal           @map("grand_total") @db.Decimal(14, 2)
  roundingAdjustment Decimal           @default(0) @map("rounding_adjustment") @db.Decimal(14, 2)
  notes              String?
  idempotencyKey     String?           @unique @map("idempotency_key")
  createdById        String?           @map("created_by_id")
  confirmedAt        DateTime?         @map("confirmed_at")
  voidedAt           DateTime?         @map("voided_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  originalSale   Order?    @relation("CreditNoteToSale", fields: [originalSaleId], references: [id], onDelete: Restrict)
  creditNotes    Order[]   @relation("CreditNoteToSale")
  createdBy      User?     @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  offerId        String?   @map("offer_id")
  offer          Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)

  items            OrderItem[]
  payments         Payment[]
  salesReturns     SalesReturn[]
  exchangesOrig    Exchange[] @relation("ExchangeOriginalOrder")
  exchangesNew     Exchange[] @relation("ExchangeNewOrder")
  whatsappLogs     WhatsAppLog[]

  @@index([documentType, status, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([confirmedAt(sort: Desc)])
  @@index([originalSaleId])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String   @map("order_id")
  variantId          String   @map("variant_id")
  quantity           Int
  unitPrice          Decimal  @map("unit_price") @db.Decimal(14, 4)
  itemDiscountType      RetailDiscountType? @map("item_discount_type")
  itemDiscountValue     Decimal?            @map("item_discount_value") @db.Decimal(14, 4)
  itemDiscountAmount    Decimal             @default(0) @map("item_discount_amount") @db.Decimal(14, 4)
  cartDiscountAllocated Decimal             @default(0) @map("cart_discount_allocated") @db.Decimal(14, 4)
  lineDiscount       Decimal  @default(0) @map("line_discount") @db.Decimal(14, 4)
  taxableValue       Decimal  @map("taxable_value") @db.Decimal(14, 4)
  cgstRate           Decimal  @default(0) @map("cgst_rate") @db.Decimal(6, 3)
  sgstRate           Decimal  @default(0) @map("sgst_rate") @db.Decimal(6, 3)
  igstRate           Decimal  @default(0) @map("igst_rate") @db.Decimal(6, 3)
  cgstAmount         Decimal  @default(0) @map("cgst_amount") @db.Decimal(14, 4)
  sgstAmount         Decimal  @default(0) @map("sgst_amount") @db.Decimal(14, 4)
  igstAmount         Decimal  @default(0) @map("igst_amount") @db.Decimal(14, 4)
  lineTotal          Decimal  @map("line_total") @db.Decimal(14, 4)
  isGiveaway         Boolean  @default(false) @map("is_giveaway")
  unitCostSnapshot   Decimal? @map("unit_cost_snapshot") @db.Decimal(14, 4)
  giveawayReason     String?  @map("giveaway_reason")
  sourceOrderItemId  String?  @map("source_order_item_id")
  createdAt          DateTime @default(now()) @map("created_at")

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sourceLine      OrderItem?     @relation("OrderItemProvenance", fields: [sourceOrderItemId], references: [id], onDelete: SetNull)
  derivedLines    OrderItem[]    @relation("OrderItemProvenance")
  salesReturnLines SalesReturnLine[]

  @@index([orderId])
  @@index([variantId, createdAt(sort: Desc)])
  @@index([sourceOrderItemId])
  @@map("order_items")
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  WALLET
  OTHER
}

enum PaymentNature {
  RECEIPT
  REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String        @map("order_id")
  nature           PaymentNature @default(RECEIPT)
  method           PaymentMethod
  amount           Decimal       @db.Decimal(14, 2)
  status           PaymentStatus @default(COMPLETED)
  externalRef      String?       @map("external_ref")
  reconciledAt     DateTime?     @map("reconciled_at")
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, nature])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

enum OfferDiscountType {
  PERCENT
  FIXED_AMOUNT
}

model Offer {
  id             String            @id @default(cuid())
  code           String?           @unique
  name           String
  description    String?
  discountType   OfferDiscountType @map("discount_type")
  discountValue  Decimal           @map("discount_value") @db.Decimal(14, 4)
  minOrderValue  Decimal?          @map("min_order_value") @db.Decimal(14, 2)
  maxDiscount    Decimal?          @map("max_discount") @db.Decimal(14, 2)
  startsAt       DateTime?         @map("starts_at")
  endsAt         DateTime?         @map("ends_at")
  isStackable    Boolean           @default(false) @map("is_stackable")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  products OfferProduct[]
  orders   Order[]

  @@index([isActive, startsAt, endsAt])
  @@map("offers")
}

enum OfferScope {
  PRODUCT
}

model OfferProduct {
  offerId   String @map("offer_id")
  productId String @map("product_id")

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@map("offer_products")
}

// ---------------------------------------------------------------------------
// Returns & exchanges
// ---------------------------------------------------------------------------

enum SalesReturnStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnDisposition {
  RESTOCK
  NO_RESTOCK
}

model SalesReturn {
  id          String            @id @default(cuid())
  orderId     String            @map("order_id")
  status      SalesReturnStatus @default(REQUESTED)
  reason      String?
  notes       String?
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  order  Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines  SalesReturnLine[]
  exchange Exchange?

  @@index([orderId, status])
  @@index([createdAt(sort: Desc)])
  @@map("sales_returns")
}

model SalesReturnLine {
  id              String            @id @default(cuid())
  salesReturnId   String            @map("sales_return_id")
  orderItemId     String            @map("order_item_id")
  quantity        Int
  disposition     ReturnDisposition
  createdAt       DateTime          @default(now()) @map("created_at")

  salesReturn SalesReturn  @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([salesReturnId])
  @@index([orderItemId])
  @@map("sales_return_lines")
}

enum ExchangeStatus {
  OPEN
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

model Exchange {
  id               String         @id @default(cuid())
  originalOrderId  String         @map("original_order_id")
  newOrderId       String?        @map("new_order_id")
  salesReturnId    String?        @unique @map("sales_return_id")
  status           ExchangeStatus @default(OPEN)
  notes            String?
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  originalOrder Order        @relation("ExchangeOriginalOrder", fields: [originalOrderId], references: [id], onDelete: Restrict)
  newOrder      Order?       @relation("ExchangeNewOrder", fields: [newOrderId], references: [id], onDelete: SetNull)
  salesReturn   SalesReturn? @relation(fields: [salesReturnId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@map("exchanges")
}

// ---------------------------------------------------------------------------
// Notifications & WhatsApp
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
}

enum NotificationStatus {
  UNREAD
  READ
}

model Notification {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  channel   NotificationChannel  @default(IN_APP)
  status    NotificationStatus   @default(UNREAD)
  title     String
  body      String
  data      Json?
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
  @@map("notifications")
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppLog {
  id                 String                  @id @default(cuid())
  customerId         String?                 @map("customer_id")
  orderId            String?                 @map("order_id")
  templateName       String?                 @map("template_name")
  toPhone            String                  @map("to_phone")
  payload            Json?
  providerMessageId String?                 @map("provider_message_id")
  status             WhatsAppMessageStatus   @default(QUEUED)
  errorCode          String?                 @map("error_code")
  errorDetail        String?                 @map("error_detail")
  sentAt             DateTime?               @map("sent_at")
  deliveredAt        DateTime?               @map("delivered_at")
  readAt             DateTime?               @map("read_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([status, createdAt(sort: Desc)])
  @@index([providerMessageId])
  @@map("whatsapp_logs")
}

// ---------------------------------------------------------------------------
// Bulk import
// ---------------------------------------------------------------------------

enum BulkImportBatchStatus {
  AWAITING_STOCK
  COMPLETED
  ROLLED_BACK
}

model BulkImportBatch {
  id             String                @id @default(cuid())
  status         BulkImportBatchStatus @default(COMPLETED)
  rowsImported   Int                   @map("rows_imported")
  createdById    String?               @map("created_by_id")
  rolledBackAt   DateTime?             @map("rolled_back_at")
  rolledBackById String?               @map("rolled_back_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  createdBy      User?           @relation("BulkImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rolledBackBy   User?           @relation("BulkImportBatchRolledBackBy", fields: [rolledBackById], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]

  @@index([createdAt(sort: Desc)])
  @@map("bulk_import_batches")
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARY
  MARKETING
  LOGISTICS
  MAINTENANCE
  OFFICE_SUPPLIES
  MISCELLANEOUS
}

enum ExpensePaymentMode {
  CASH
  UPI
}

model Expense {
  id          String             @id @default(cuid())
  title       String
  amount      Decimal            @db.Decimal(14, 2)
  category    ExpenseCategory
  paymentMode ExpensePaymentMode @default(CASH) @map("payment_mode")
  date        DateTime           @db.Date
  note        String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@index([category])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Owner capital & drawings (money the owner puts in / takes out — not P&L)
// ---------------------------------------------------------------------------

enum CapitalEntryType {
  INVESTMENT
  DRAWING
}

model CapitalEntry {
  id        String           @id @default(cuid())
  type      CapitalEntryType
  amount    Decimal          @db.Decimal(14, 2)
  date      DateTime         @db.Date
  note      String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@index([type])
  @@map("capital_entries")
}

// ---------------------------------------------------------------------------
// Purchase returns (debit notes to suppliers)
// ---------------------------------------------------------------------------

enum PurchaseReturnStatus {
  CONFIRMED
  CANCELLED
}

/** Only settlement methods that move real money into the combined cash figure. */
enum PurchaseReturnSettlement {
  CASH
  BANK
  UPI
}

model PurchaseReturn {
  id               String                   @id @default(cuid())
  supplierId       String                   @map("supplier_id")
  status           PurchaseReturnStatus     @default(CONFIRMED)
  /** Book value of returned stock = sum of line qty x WAC snapshot. */
  bookValue        Decimal                  @map("book_value") @db.Decimal(14, 2)
  /** Actual amount the supplier refunded (what increases cash). */
  refundAmount     Decimal                  @map("refund_amount") @db.Decimal(14, 2)
  /** refundAmount - bookValue. Positive = gain, negative = loss. */
  difference       Decimal                  @db.Decimal(14, 2)
  settlementMethod PurchaseReturnSettlement  @default(CASH) @map("settlement_method")
  note             String?
  /** Client-supplied key; duplicate confirms with an identical payload return the same row. */
  idempotencyKey   String                   @unique @map("idempotency_key")
  createdById      String?                  @map("created_by_id")
  confirmedById    String?                  @map("confirmed_by_id")
  createdAt        DateTime                 @default(now()) @map("created_at")
  confirmedAt      DateTime?                @map("confirmed_at")

  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy User?                @relation("PurchaseReturnConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  lines       PurchaseReturnLine[]

  @@index([supplierId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id               String   @id @default(cuid())
  purchaseReturnId String   @map("purchase_return_id")
  variantId        String   @map("variant_id")
  quantity         Int
  /** WAC per unit captured at confirm time (same basis as inventory valuation). */
  unitWac          Decimal  @map("unit_wac") @db.Decimal(14, 6)
  lineBookValue    Decimal  @map("line_book_value") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([variantId])
  @@map("purchase_return_lines")
}
