# =============================================================================
# GV Nutrition — FRONTEND reference config.
# Copy to frontend/.env and fill in. Never commit the real .env.
#
# IMPORTANT: every VITE_* value is baked in at BUILD time, not read at runtime.
# On Railway a VITE_* var reaches production ONLY if you do BOTH:
#   1. set it in the service Variables, AND
#   2. add matching `ARG VITE_X` + `ENV VITE_X=$VITE_X` in frontend/Dockerfile
#      before `RUN npm run build`.
# Skip step 2 and it silently bakes as undefined. See docs/GVN_handoff.md §10.
# =============================================================================

# Dev: leave unset — Vite proxies /api to http://localhost:4100 (vite.config.ts).
# Production: absolute backend URL.
# VITE_API_URL=

# Base URL for WhatsApp invoice links (<base>/i/<orderId>).
# Use the frontend URL so /i/:id opens the SPA and redirects to the API PDF.
# VITE_PUBLIC_INVOICE_BASE_URL=https://gvnutrition.attirebygv.in

# Store branding shown in the web UI and WhatsApp messages.
# Vite serves frontend/public at the web root → frontend/public/brand/gvlogo.png.
# Artwork is black on transparency; logo <img> tags carry `dark:invert` so it
# stays visible in dark mode.
VITE_STORE_NAME=GV Nutrition
VITE_STORE_LOGO_PATH=/brand/gvlogo.png

# Cross-link to the other GV business — the top-bar switch button.
# This is the NUTRITION app, so it points AT ATTIRE. Unset hides the button.
VITE_OTHER_APP_URL=https://attirebygv.in
VITE_OTHER_APP_NAME=Attire by GV
